# Copy to .env and fill in. .env is git-ignored - never commit real credentials.
# Any platform left blank is reported as "failed: Not configured" and the rest still post.

HTTP_TIMEOUT_SECONDS=15

# Bluesky - Settings > Privacy and security > App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# Mastodon - Preferences > Development > New application (scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Telegram - token from @BotFather; bot must be an admin of the channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# GitHub - fine-grained token with "Gists: read and write" (or classic token with `gist` scope)
GITHUB_TOKEN=

# DEV Community - dev.to Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# Discord - Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Rentry and paste.rs need no account and always post.
# Optional: a fixed Rentry edit code so you can edit/delete pages on rentry.co later.
RENTRY_EDIT_CODE=
